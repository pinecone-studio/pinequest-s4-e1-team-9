NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical backend origin. Production must be the deployed HTTPS backend,
# for example: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional legacy per-resource overrides. Leave blank when NEXT_PUBLIC_API_URL
# is set unless a resource intentionally lives on a different backend origin.
NEXT_PUBLIC_CHAT_API_URL=http://localhost:4000/chat
NEXT_PUBLIC_UPLOAD_API_URL=http://localhost:4000/upload
NEXT_PUBLIC_DOCUMENTS_API_URL=http://localhost:4000/documents
NEXT_PUBLIC_COMPANIES_API_URL=http://localhost:4000/api/companies
NEXT_PUBLIC_INVITES_API_URL=http://localhost:4000/api/invites
NEXT_PUBLIC_PREFERENCES_API_URL=http://localhost:4000/api/me/preferences
NEXT_PUBLIC_PROFILE_API_URL=http://localhost:4000/api/me/profile
NEXT_PUBLIC_EVENTS_API_BASE_URL=http://localhost:4000/api/ais
NEXT_PUBLIC_ADMIN_COMPANIES_API_URL=http://localhost:4000/admin/companies
