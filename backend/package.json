{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "start": "bun dist/src/index.js",
    "chatbot": "bun src/index.ts",
    "build": "bunx prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bunx prisma migrate deploy",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:changed": "jest --onlyChanged --passWithNoTests",
    "test:related": "jest --findRelatedTests",
    "test:coverage": "jest --coverage",
    "test:int": "jest --testPathPattern=\\.int\\.test\\.ts$",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "langgraph:dev": "langgraphjs dev"
  },
  "dependencies": {
    "@langchain/community": "^0.3.26",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/groq": "^1.2.1",
    "@langchain/langgraph": "^1.3.5",
    "@langchain/langgraph-checkpoint": "~0.0.17",
    "@langchain/langgraph-cli": "0.0.71",
    "@langchain/langgraph-sdk": "~0.0.70",
    "@langchain/openai": "^0.3.17",
    "@langchain/textsplitters": "^0.1.0",
    "@mendable/firecrawl-js": "^1.15.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.48.1",
    "chromadb": "^1.10.4",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.1",
    "@jest/globals": "^29.7.0",
    "@tsconfig/recommended": "^1.0.7",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "5.59.8",
    "@typescript-eslint/parser": "5.59.8",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-no-instanceof": "^1.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^7.8.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0"
  }
}
